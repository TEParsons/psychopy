                },
                "uncomment": {
                    "title": "uncomment",
                    "description": "from start of line(s)",
                    "type": "string",
                    "default": "\"Ctrl+Shift+'\""
                },
                "toggle comment": {
                    "title": "toggle comment",
                    "description": "from start of line(s)",
                    "type": "string",
                    "default": "\"Ctrl+/\""
                },
                "fold": {
                    "title": "fold",
                    "description": "Coder: fold this block of code",
                    "type": "string",
                    "default": "Ctrl+Home"
                },
                "enlargeFont": {
                    "title": "enlarge Font",
                    "description": "Coder: increase font size this block of code",
                    "type": "string",
                    "default": "Ctrl+="
                },
                "shrinkFont": {
                    "title": "shrink Font",
                    "description": "Coder: decrease font size this block of code",
