                    "default": "Shift+Tab"
                },
                "find": {
                    "title": "find",
                    "description": "Coder: find",
                    "type": "string",
                    "default": "Ctrl+F"
                },
                "findAgain": {
                    "title": "find Again",
                    "description": "Coder: find again",
                    "type": "string",
