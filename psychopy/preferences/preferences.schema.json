                },
                "runScript": {
                    "title": "run Script",
                    "description": "launch a script, Builder or Coder, or run unit-tests",
                    "type": "string",
                    "default": "Ctrl+Shift+R"
                },
                "runnerScript": {
                    "title": "runner Script",
                    "description": "launch a script, Builder or Coder, or run unit-tests",
                    "type": "string",
                    "default": "Ctrl+Alt+R"
                },
                "stopScript": {
                    "title": "stop Script",
                    "description": "attempt to interrupt and halt a running script",
                    "type": "string",
                    "default": "Ctrl+."
                },
                "toggleWhitespace": {
                    "title": "toggle Whitespace",
                    "description": "",
                    "type": "string",
                    "default": "Ctrl+Shift+W"
                },
                "toggleEOLs": {
                    "title": "toggle EOLs",
                    "description": "Coder: show / hide end of line characters",
                    "type": "string",
                    "default": "Ctrl+Shift+L"
                },
                "toggleIndentGuides": {
                    "title": "toggle Indent Guides",
                    "description": "Coder: show / hide indentation level lines",
                    "type": "string",
                    "default": "Ctrl+Shift+I"
                },
                "expSettings": {
                    "title": "exp Settings",
                    "description": "",
                    "type": "string",
                    "default": "Ctrl+Shift+X"
                },
                "newRoutine": {
                    "title": "new Routine",
                    "description": "Builder: create a new routine",
                    "type": "string",
                    "default": "Ctrl+Shift+N"
                },
                "copyRoutine": {
                    "title": "copy Routine",
                    "description": "Builder: copy an existing routine",
                    "type": "string",
                    "default": "Ctrl+Shift+C"
                },
                "pasteRoutine": {
                    "title": "paste Routine",
                    "description": "Builder: paste the copied routine",
                    "type": "string",
                    "default": "Ctrl+Shift+V"
                },
                "pasteCompon": {
                    "title": "paste Compon",
                    "description": "Builder: paste the copied component",
                    "type": "string",
                    "default": "Ctrl+Alt+V"
                },
                "builderFind": {
                    "title": "builder Find",
                    "description": "Builder: find",
                    "type": "string",
                    "default": "Ctrl+F"
                },
                "toggleOutputPanel": {
                    "title": "toggle Output Panel",
                    "description": "Coder: show / hide the output panel",
                    "type": "string",
                    "default": "Ctrl+Shift+O"
                },
                "renameRoutine": {
                    "title": "rename Routine",
                    "description": "    #Builder: rename an existing routine",
                    "type": "string",
                    "default": "Ctrl+Shift+M"
                },
                "cycleWindows": {
                    "title": "cycle Windows",
                    "description": "switch between windows",
                    "type": "string",
                    "default": "Ctrl+L"
                },
                "largerFlow": {
                    "title": "larger Flow",
                    "description": "increase display size in Flow",
                    "type": "string",
                    "default": "Ctrl+="
                },
                "smallerFlow": {
                    "title": "smaller Flow",
                    "description": "decrease display size in Flow",
